import kagglehub
path = kagglehub.dataset_download("sootersaalu/amazon-top-50-bestselling-books-2009-2019")

from multiprocessing import Pool
from collections import defaultdict
import os # Import os module

def mapper(line):
    fields = line.strip().split(",")
    # Check if there are enough fields and if the 5th field (index 4) exists
    if len(fields) > 4:
        publisher = fields[4]
        return (publisher, 1)
    return None # Return None for invalid lines

def reducer(mapped_data):
    result = defaultdict(int)
    for item in mapped_data:
        if item:
            key, value = item
            result[key] += value
    return result

if __name__ == "__main__":
    # The 'path' variable is from the previous cell where the dataset was downloaded
    # It contains the directory where the dataset files are extracted.
    # We need to construct the full path to 'bestsellers with categories.csv'
    file_path = os.path.join(path, "bestsellers with categories.csv")
    with open(file_path, encoding="utf-8") as f:
        lines = f.readlines()[1:]  # header 제거

    with Pool(4) as p:
        mapped = p.map(mapper, lines)

    final_result = reducer(mapped)

    for k, v in list(final_result.items())[:10]:
        print(k, v)
